# Телеграм-бот
TELEGRAM_BOT_TOKEN = "7440702283:AAF0TXXoZT6vjmGapMB3MDB0zhuEZoDjytg"  # Укажи свой токен
GROUP_CHAT_ID = "-1002360245429"  # Укажи ID чата

# Файл для хранения отзывов
REVIEWS_FILE = "reviews.txt"

def send_telegram_message(message):
    """Отправляет сообщение в Telegram"""
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {"chat_id": GROUP_CHAT_ID, "text": message, "parse_mode": "HTML"}
    response = requests.post(url, data=payload)
    if response.status_code != 200:
        print(f"⚠️ Ошибка отправки в Telegram: {response.text}")
    else:
        print(f"✅ Отправлено в Telegram: {message}")


def load_reviews():
    """Загружает уже сохранённые отзывы из файла"""
    if os.path.exists(REVIEWS_FILE):
        with open(REVIEWS_FILE, "r", encoding="utf-8") as file:
            return set(file.read().split("\n"))
    return set()


def save_reviews(reviews):
    """Сохраняет новые отзывы в файл"""
    with open(REVIEWS_FILE, "w", encoding="utf-8") as file:
        file.write("\n".join(reviews))

# Загружаем старые отзывы
saved_reviews = load_reviews()
first_run = len(saved_reviews) == 0  # Если файл пустой, это первый запуск

# Настройки Selenium
chrome_options = Options()
chrome_options.add_argument("--disable-blink-features=AutomationControlled")
chrome_options.add_argument("--start-maximized")


service = Service("C:\\Users\\prilo\\Downloads\\chromedriver-win64\\chromedriver-win64\\chromedriver.exe")
driver = webdriver.Chrome(service=service, options=chrome_options)

url = "https://yandex.ru/maps/org/top/202052871280/reviews"
driver.get(url)

wait = WebDriverWait(driver, 20)

def deep_scroll_with_protection():
    """Использует прокрутку мышью + защиту от stale element"""
    last_count = 0
    while True:
        try:
            reviews = driver.find_elements(By.CSS_SELECTOR, ".business-reviews-card-view__review")
            if not reviews:
                break

            last_review = reviews[-1]
            actions = ActionChains(driver)
            actions.move_to_element(last_review).perform()
            time.sleep(3)

            new_count = len(driver.find_elements(By.CSS_SELECTOR, ".business-reviews-card-view__review"))
            if new_count == last_count:
                break
            last_count = new_count

        except Exception as e:
            print(f"⚠️ Ошибка при скроллинге: {e}")
            time.sleep(5)

try:
    wait.until(EC.presence_of_element_located((By.TAG_NAME, "body")))
    print("✅ Страница загружена!")

    while True:
        deep_scroll_with_protection()
        wait.until(EC.presence_of_element_located((By.CSS_SELECTOR, ".business-reviews-card-view__review")))

        reviews = driver.find_elements(By.CSS_SELECTOR, ".business-reviews-card-view__review")
        total_reviews = len(reviews)

        print(f"\n📊 Всего загружено отзывов: {total_reviews}")

        new_reviews = []
        for review in reviews:
            try:
                text = review.text.strip()
                if text and text not in saved_reviews:
                    new_reviews.append(text)
            except Exception as e:
                print(f"⚠️ Ошибка чтения отзыва: {e}")

        if new_reviews:
            print("\n🔹 Найдены новые отзывы! Добавляем в файл и отправляем в Telegram...")
            saved_reviews.update(new_reviews)
            save_reviews(saved_reviews)
            for review in new_reviews:
                send_telegram_message(f"🆕 <b>Новый отзыв:</b>\n{review}")
        else:
            send_telegram_message("✅ Парсер работает. Новых отзывов не найдено.")

        print("\n⏳ Ожидание 30 минут перед проверкой новых отзывов...")
        time.sleep(1800)
        print("\n🔄 Обновляем страницу для проверки новых отзывов...")
        driver.refresh()

except Exception as e:
    print(f"❌ Ошибка: {e}")

finally:
    driver.quit()
